# Copy to .env and fill in. Get the token from @BotFather (/newbot),
# your chat id from @userinfobot. Then send your bot one message first.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

CHECK_INTERVAL_SECONDS=180
MIN_PRICE=150
MAX_PRICE=500
# true = don't alert on listings that already exist at first start
SEED_SILENTLY=false

# Optional: your own Kleinanzeigen search links, comma-separated.
# Leave empty to use the two default Berlin searches (apartments + WG rooms).
KLEINANZEIGEN_URLS=
