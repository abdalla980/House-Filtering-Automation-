# Copy to .env and fill in. Get the token from @BotFather (/newbot),
# your chat id from @userinfobot. Then send your bot one message first.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

CHECK_INTERVAL_SECONDS=180
MIN_PRICE=150
MAX_PRICE=2000
MIN_ROOMS=4
MAX_ROOMS=5
MIN_SIZE_M2=85
# true = don't alert on listings that already exist at first start
SEED_SILENTLY=false

# Optional: your own Kleinanzeigen search links, comma-separated.
# Leave empty to use the default Berlin apartment search built from the values above.
KLEINANZEIGEN_URLS=

# Optional: wanted areas as Kleinanzeigen names them, comma-separated.
# Leave empty for the default: Mitte (whole district), Reinickendorf, Wilmersdorf,
# Schöneberg, Prenzlauer Berg.
AREAS=
